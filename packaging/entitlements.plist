<!-- Hardened runtime: the bundled Python loads its own extension modules, which carry the same
     signature but no shared team ID in an ad-hoc build, so library validation must be relaxed. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
